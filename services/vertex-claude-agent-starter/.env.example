APP_NAME=vertex-claude-agent-starter
ENVIRONMENT=dev
LOG_LEVEL=INFO
SERVICE_API_KEY=replace-with-long-random-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_REGION=us-central1
CLOUD_ML_REGION=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
CLAUDE_MODEL=claude-sonnet-4@20250514
REQUEST_TIMEOUT_SECONDS=45
MAX_INPUT_CHARS=10000
MAX_TURNS=6
MAX_TOOL_CALLS=6
ENABLED_TOOLS=calculator,current_datetime,web_search_stub
ENTERPRISE_SYSTEM_PROMPT=You are an enterprise assistant. Be concise, factual, and safe. Use tools when needed and never fabricate tool outputs.
